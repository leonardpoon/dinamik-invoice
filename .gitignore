# dependencies
/node_modules

# build output
/dist
/src-tauri/target
/src-tauri/gen/schemas

# the sample UI this app's look was taken from; kept locally for reference
/Sample UI/node_modules

# the previous Next.js app, kept until the Tauri version has been in use a while
/legacy/nextjs/node_modules
/legacy/nextjs/.next

# left over from the Next.js + portable MySQL setup
/runtime
/data
/backups

# the app's real data file lives outside the repo, in %APPDATA%, and never
# belongs here — this only catches one dropped locally, e.g. by running an
# example (`cargo run --example sample_pdfs`) without an output directory
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# misc
.DS_Store
*.tsbuildinfo
.env*
~$*
